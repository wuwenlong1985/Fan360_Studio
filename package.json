{
  "name": "fan360-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fan360/desktop",
    "build": "npm run build --workspace @fan360/desktop",
    "typecheck": "npm run typecheck --workspace @fan360/core && npm run typecheck --workspace @fan360/desktop",
    "test": "call \"%npm_node_execpath%\" node_modules/vitest/vitest.mjs run",
    "test:render": "npm run build && call \"%npm_node_execpath%\" apps/desktop/scripts/render-smoke.mjs",
    "package": "npm run package --workspace @fan360/desktop"
  },
  "dependencies": {
    "antd": "5.27.6",
    "@ant-design/v5-patch-for-react-19": "1.0.3"
  }
}
